#!/bin/sh
root=$(cd "$(dirname "$0")/.." && pwd)
version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$root/.claude-plugin/plugin.json" | head -n 1)
home=${PAUL_HOME:-$HOME/.claude/paul}
bin=$home/bin/paul-$version
lock=$home/install.lock
mode=command
[ "${1:-}" = hook ] && mode=hook

if [ -x "$bin" ]; then
  exec "$bin" "$@"
fi

log() {
  (umask 077; mkdir -p "$home"; printf '%s launcher: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" >> "$home/paul.log")
  [ "$mode" = command ] && echo "paul : $1" >&2
  return 1
}

say() {
  [ "$mode" = command ] && echo "paul : $1" >&2
  return 0
}

acquire() {
  tries=0
  while ! mkdir "$lock" 2>/dev/null; do
    tries=$((tries + 1))
    [ "$tries" -gt 600 ] && return 2
    if [ -n "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
      rmdir "$lock" 2>/dev/null
      continue
    fi
    [ "$mode" = hook ] && return 1
    [ -x "$bin" ] && return 1
    sleep 0.2
  done
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d ' ' -f 1
  else
    shasum -a 256 "$1" | cut -d ' ' -f 1
  fi
}

install() {
  [ -n "$version" ] || { log "version introuvable dans plugin.json"; return 1; }
  case "$(uname -s)" in
    Darwin) os=darwin ;;
    Linux) os=linux ;;
    *) log "système non pris en charge : $(uname -s)"; return 1 ;;
  esac
  case "$(uname -m)" in
    arm64 | aarch64) arch=arm64 ;;
    x86_64 | amd64) arch=amd64 ;;
    *) log "architecture non prise en charge : $(uname -m)"; return 1 ;;
  esac
  name=paul-$os-$arch
  url=https://github.com/jplot/brain/releases/download/v$version
  (umask 077; mkdir -p "$home/bin") || return 1

  acquire
  case $? in
    0) ;;
    2) log "verrou d'installation toujours pris, abandon"; return 1 ;;
    *) return 0 ;;
  esac
  part=$home/bin/.paul-$version.part.$$
  sums=$home/bin/.paul-$version.sums.$$
  rm -f "$home"/bin/.paul-*.part.* "$home"/bin/.paul-*.sums.*
  trap 'rm -f "$part" "$sums"; rmdir "$lock" 2>/dev/null; exit 1' HUP INT TERM
  fetch
  status=$?
  trap - HUP INT TERM
  rmdir "$lock" 2>/dev/null
  return $status
}

download() {
  curl -fsSL --proto '=https' --proto-redir '=https' --connect-timeout 10 --max-time 300 -o "$1" "$2"
}

fetch() {
  [ -x "$bin" ] && return 0
  say "téléchargement de $name $version"
  if ! download "$part" "$url/$name" || ! download "$sums" "$url/checksums.txt"; then
    rm -f "$part" "$sums"
    log "échec du téléchargement de $name $version"
    return 1
  fi
  expected=$(awk -v n="$name" '$2 == n { print $1 }' "$sums")
  actual=$(sha256_of "$part")
  rm -f "$sums"
  if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
    rm -f "$part"
    log "empreinte incorrecte pour $name $version, binaire écarté"
    return 1
  fi
  chmod 755 "$part" && mv -f "$part" "$bin"
}

if [ "$mode" = hook ]; then
  (install >/dev/null 2>&1 </dev/null &)
  exit 0
fi

install || exit 1
exec "$bin" "$@"
